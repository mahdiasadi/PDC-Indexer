<Window x:Class="ProjectIndexer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProjectIndexer.Wpf.ViewModels"
        xmlns:c="clr-namespace:ProjectIndexer.Wpf.Converters"
        mc:Ignorable="d"
        Title="ProjectIndexer" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <c:SizeConverter x:Key="SizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <c:InverseBoolConverter x:Key="BoolInvert"/>
        <Style TargetType="ListViewItem">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Margin="0,0,0,4">
            <Button Command="{Binding IndexAllDrivesCommand}" IsEnabled="{Binding IsIndexing, Converter={StaticResource BoolInvert}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Margin="2,0">&#x23;</TextBlock>
                    <TextBlock Margin="4,0,0,0">Index All</TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding LoadFromDatabaseCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="4,0">Load Saved</TextBlock>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ShowArchivesCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="4,0">Archives</TextBlock>
                </StackPanel>
            </Button>
            <Separator/>
            <Label Padding="4,0" VerticalAlignment="Center">Drives:</Label>
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                  Margin="2,0" VerticalAlignment="Center" FontSize="12"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ToolBar>

        <!-- Search Scope -->
        <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1" Margin="0,0,0,2"
                Background="#F5F5F5" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0" Foreground="#555">
                    Scope:
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Padding="4,2" BorderThickness="0"
                         Background="Transparent" ToolTip="Leave empty to index entire drive; or type a subfolder path like C:\Users\Downloads"/>
                <Button Grid.Column="2" Command="{Binding ClearFolderCommand}" Margin="4,0" Padding="6,1">Clear</Button>
            </Grid>
        </Border>

        <!-- Search Box -->
        <Border Grid.Row="3" BorderBrush="#888" BorderThickness="1" Margin="0,0,0,4"
                Background="#F5F5F5" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0" Foreground="#555">
                    &#x1F50D; Search:
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="4,2" BorderThickness="0"
                         Background="Transparent"/>
                <ProgressBar Grid.Column="2" Width="120" Height="16" Margin="4,0"
                             Value="{Binding IndexProgress}" Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVis}}"
                             IsIndeterminate="False"/>
            </Grid>
        </Border>

        <!-- Results Grid -->
        <ListView Grid.Row="4" ItemsSource="{Binding ResultsView}"
                  SelectedItem="{Binding SelectedEntry}"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="Name" Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Path" Width="280"
                                    DisplayMemberBinding="{Binding FullPath}"/>
                    <GridViewColumn Header="Size" Width="90"
                                    DisplayMemberBinding="{Binding SizeDisplay}"/>
                    <GridViewColumn Header="Date Modified" Width="140"
                                    DisplayMemberBinding="{Binding DateModified}"/>
                    <GridViewColumn Header="Date Created" Width="140"
                                    DisplayMemberBinding="{Binding DateCreated}"/>
                    <GridViewColumn Header="Type" Width="140"
                                    DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Attrs" Width="60"
                                    DisplayMemberBinding="{Binding Attributes}"/>
                    <GridViewColumn Header="Source" Width="80"
                                    DisplayMemberBinding="{Binding Source}"/>
                </GridView>
            </ListView.View>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Command="{Binding OpenFileCommand}"/>
                    <MenuItem Header="Open Path" Command="{Binding OpenPathCommand}"/>
                    <Separator/>
                    <MenuItem Header="Copy Full Path" Command="{Binding CopyPathCommand}"/>
                    <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5" Margin="0,4,0,0">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                        <TextBlock FontSize="12" Text="Archives: "/>
                        <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding ArchiveCount}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding IndexProgressText}" FontSize="12" Margin="8,0,0,0"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
